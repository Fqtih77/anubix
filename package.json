{
  "name": "anubix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "PORT=3005 node .next/standalone/server.js",
    "setup": "node scripts/setup.mjs",
    "mail:worker": "node scripts/mail-worker.mjs",
    "mail:check": "node scripts/mail-worker.mjs --once",
    "test:mail": "node --test scripts/mail-worker.test.mjs",
    "lint": "biome lint src next.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@biomejs/biome": "2.5.15",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
